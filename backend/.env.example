# Environment Configuration (Copy to .env and fill in your values)

# Environment
# Allowed: development, production, test
ENVIRONMENT=development
DEBUG=false
# Allowed: debug, info, warning, error, critical
LOG_LEVEL=info

# Database (PostgreSQL for MVP)
# Local PostgreSQL example:
# Required: must include a valid scheme (postgresql://, postgres://, sqlite:///)
DATABASE_URL=postgresql://debateuser:debatepass@localhost:5432/social_debate
# Production example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_ECHO=false

# Hacker News API
# No credentials required — uses the public Firebase API (no auth needed)
# https://hacker-news.firebaseio.com/v0/
MIN_COMMENTS_THRESHOLD=50
HN_MAX_DEPTH=3

# API Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]

# Scheduler
SCHEDULER_ENABLED=true
# Must be > 0
FETCH_INTERVAL_MINUTES=30
CLASSIFY_INTERVAL_HOURS=6
CLUSTER_INTERVAL_HOURS=12
STATS_JOB_INTERVAL_HOURS=1

# Data Limits
# Must be >= MAX_COMMENTS_PER_FETCH
MAX_COMMENTS_PER_TOPIC=25000
MAX_COMMENTS_PER_POST=1000
MAX_COMMENTS_PER_FETCH=2000
HISTORY_DAYS=30

# ML/NLP Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOXICITY_MODEL=toxigen/roberta-large-toxic-comments
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Clustering
N_CLUSTERS_PER_STANCE=10
# Must be >= 2
MIN_CLUSTER_SIZE=8
MIN_QUOTE_LENGTH=40

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
