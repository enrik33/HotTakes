{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://hottakes-production.up.railway.app/api/:path*"
        },
        {
            "source": "/health",
            "destination": "https://hottakes-production.up.railway.app/health"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
