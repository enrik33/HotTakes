{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_RAILWAY_URL/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://YOUR_RAILWAY_URL/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
